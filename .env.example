# API Configuration
VITE_API_BASE_URL=http://localhost:3212
VITE_API_BASE_URL_PRODUCTION=https://your-api-domain.com

# Chat & Socket Configuration
VITE_SOCKET_URL=http://localhost:3212
VITE_SOCKET_URL_PRODUCTION=https://your-api-domain.com

# API Endpoints
VITE_CHAT_HISTORY_ENDPOINT=/chat/history
VITE_CHECKOUT_ENDPOINT=/api/checkout
VITE_HEALTH_CHECK_ENDPOINT=/health

# External URLs
VITE_YOUTUBE_EMBED_BASE=https://www.youtube.com/embed/
VITE_GOOGLE_DRIVE_EMBED_BASE=https://drive.google.com/file/d/
VITE_GOOGLE_DRIVE_PREVIEW_SUFFIX=/preview

# Social Media Links
VITE_FACEBOOK_URL=https://www.facebook.com/your-page

# Default Images & Placeholders
VITE_DEFAULT_COURSE_IMAGE=https://images.unsplash.com/photo-1594322436404-5a0526db4d13?w=500&auto=format&fit=crop&q=60
VITE_DEFAULT_PROFILE_BG=https://images.unsplash.com/photo-1506748686214-e9df14d4d9d0?ixlib=rb-1.2.1&auto=format&fit=crop&w=1350&q=80
VITE_DEFAULT_LEARNING_IMAGE=https://images.unsplash.com/photo-1695702273667-bbd3af94d45f?w=500&auto=format&fit=crop&q=60
VITE_DEFAULT_EXAM_IMAGE=https://plus.unsplash.com/premium_photo-1661411124435-5de83a96be24?w=500&auto=format&fit=crop&q=60
VITE_DEFAULT_BASIC_CHINESE_IMAGE=https://plus.unsplash.com/premium_photo-1661600619578-2d9e2593bbfc?w=500&auto=format&fit=crop&q=60

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key-here
VITE_AUTH_TOKEN_EXPIRY=24h

# Database Configuration (for backend reference)
VITE_DATABASE_URL=your-database-connection-string

# External APIs
# YouTube API (if needed for video processing)
VITE_YOUTUBE_API_KEY=your-youtube-api-key-here

# Google Drive API (for video embedding)
VITE_GOOGLE_DRIVE_API_KEY=your-google-drive-api-key-here
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# File Upload Configuration
VITE_MAX_FILE_SIZE=50MB
VITE_ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,mp4,avi,mov,pdf,doc,docx

# Payment Configuration
VITE_PAYMENT_GATEWAY_URL=your-payment-gateway-url
VITE_PAYMENT_API_KEY=your-payment-api-key
VITE_PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Email Configuration (for notifications)
VITE_SMTP_HOST=smtp.gmail.com
VITE_SMTP_PORT=587
VITE_SMTP_USER=your-email@gmail.com
VITE_SMTP_PASS=your-app-password
VITE_EMAIL_FROM=noreply@yourdomain.com

# Chat/Socket Configuration
VITE_SOCKET_URL=http://localhost:3212
VITE_SOCKET_PATH=/socket.io

# Security
VITE_CORS_ORIGIN=http://localhost:5173
VITE_SESSION_SECRET=your-session-secret-key

# Analytics (if using)
VITE_GOOGLE_ANALYTICS_ID=your-google-analytics-id
VITE_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Feature Flags
VITE_ENABLE_CHAT=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SOCIAL_LOGIN=false

# Development
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=info